{
  "name": "diff-replay",
  "version": "0.1.0",
  "description": "A persistent local viewer for replaying large diffs as reviewable, atomic steps.",
  "type": "module",
  "bin": {
    "diff-replay": "dist/cli.js"
  },
  "files": [
    "dist",
    "examples",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && vite build",
    "check": "prettier --check . && tsc --noEmit && vitest run",
    "dev": "vite",
    "dev:server": "tsx watch src/cli.ts serve --api-only",
    "diff-replay": "tsx src/cli.ts",
    "format": "prettier --write .",
    "start": "node dist/cli.js serve",
    "test": "vitest run"
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "code-review",
    "diff",
    "git",
    "pull-request"
  ],
  "license": "MIT",
  "dependencies": {
    "@fastify/static": "^10.1.3",
    "fastify": "^5.6.0",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "prettier": "^3.6.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vitest": "^3.2.4"
  }
}
